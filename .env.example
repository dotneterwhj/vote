REDIS_URL=redis://:admin@localhost:6379

# Upstash Redis 配置（用于 Cloudflare Worker / Serverless / Edge 环境；若配置则优先使用）
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
PORT=3000
DATA_DIR=.data
ADMIN_PASSWORD=change-me

# 钉钉微应用免登配置（如未配置，系统会自动提供模拟身份用于本地开发）
DINGTALK_CORP_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# 企业微信微应用免登配置（如未配置，系统会自动提供模拟身份用于本地开发）
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CORP_SECRET=
